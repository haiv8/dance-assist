# App
DANCE_ASSIST_APP_NAME=dance-assist-api

# API prefixes
DANCE_ASSIST_API_PREFIX=/api
DANCE_ASSIST_API_V1_PREFIX=/api/v1
DANCE_ASSIST_ENABLE_V1_ROUTES=true

# CORS (comma-separated)
DANCE_ASSIST_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Runtime data root (recommended outside repository)
# DANCE_ASSIST_HOME=C:\Users\<you>\AppData\Local\dance-assist

# Optional PostgreSQL task persistence (leave empty to use file fallback)
# DANCE_ASSIST_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/dance_assist
# DANCE_ASSIST_DATABASE_CONNECT_TIMEOUT_SEC=5

# Pipeline executor (safe default: local_thread; queue option: redis_queue)
DANCE_ASSIST_PIPELINE_EXECUTOR=local_thread
# DANCE_ASSIST_REDIS_URL=redis://127.0.0.1:6379/0
# Optional: point Redis startup scripts to an existing local redis-server.exe
# DANCE_ASSIST_REDIS_SERVER_EXE=D:\Tool\Redis-x64-3.2.100\redis-server.exe
DANCE_ASSIST_REDIS_PIPELINE_QUEUE=dance_assist:pipeline_jobs
DANCE_ASSIST_REDIS_BLOCK_TIMEOUT_SEC=5
DANCE_ASSIST_PIPELINE_MAX_RETRIES=2
DANCE_ASSIST_PIPELINE_RETRY_BACKOFF_SEC=2
DANCE_ASSIST_MIN_FREE_DISK_GB=2

# Upload limit in MB
DANCE_ASSIST_MAX_UPLOAD_MB=1024

# Output retention: keep latest N output pair folders; 0 disables cleanup
DANCE_ASSIST_RETAIN_OUTPUT_PAIRS=0

# AI coach: aliyun, openai, or local
# The AI coach explains structured analysis reports; pose scoring still comes
# from the local pose-estimation, DTW alignment, and metric pipeline.
DANCE_ASSIST_AI_PROVIDER=aliyun
# DANCE_ASSIST_ALIYUN_API_KEY=sk-...
# DANCE_ASSIST_ALIYUN_MODEL=qwen-plus
# DANCE_ASSIST_OPENAI_API_KEY=sk-...
# DANCE_ASSIST_OPENAI_MODEL=gpt-4.1-mini

# Migrate legacy backend/uploads to runtime uploads on first start
DANCE_ASSIST_MIGRATE_LEGACY_ON_START=true

# Logging
DANCE_ASSIST_LOG_LEVEL=INFO
DANCE_ASSIST_LOG_JSON=true
